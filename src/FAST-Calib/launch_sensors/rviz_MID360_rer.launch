<launch>
    <!-- ========== rervision_camera ========== -->
    <!-- <rosparam file="$(find hikrobot_camera)/config/camera-trigger.yaml" command="load" /> -->
	
	<!-- 锐尔威视USBGS1200P01 工业相机 - 匹配v4l2实际控件 & 标准XML语法 -->
	<!-- 物理节点：/dev/video0 | 分辨率：1920*1080 | 帧率：30FPS | 格式：mjpeg -->
	<node name="usbgs1200p02_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
		<!-- 基础必配参数 - 与硬件/ROS规范匹配，请勿修改 -->
		<param name="video_device" value="/dev/video0" />
		<param name="camera_name" value="usbgs1200p02_32e4_2234" />
		<param name="camera_info_url" value="" />

		<!-- 基础图像参数 - 对应说明书，可按需求修改（分辨率/帧率/格式） -->
		<!-- <param name="image_width" value="1920" />
		<param name="image_height" value="1080" /> -->
		<param name="image_width" value="1280" />
		<param name="image_height" value="720" />
		<param name="framerate" value="5" />
		<param name="pixel_format" value="mjpeg" />

		<!-- 菜单型参数 - 这些名字需要放进 intrinsic_controls 命名空间，usb_cam 才会读取 -->
		<param name="power_line_frequency" value="1" />
		<param name="intrinsic_controls/exposure_auto" value="3" />
		<param name="intrinsic_controls/white_balance_temperature_auto" value="1" />
		<param name="intrinsic_controls/ignore" value="[brightness, contrast, saturation, gain, sharpness, backlight_compensation, white_balance_temperature, exposure_absolute, pan_absolute, tilt_absolute, focus_absolute, zoom_absolute]" />

		<!-- 图像基础调节参数 - 匹配v4l2实际范围&默认值 -->
		<param name="brightness" value="0" />
		<param name="contrast" value="0" />
		<param name="saturation" value="66" />
		<param name="hue" value="90" />
		<param name="gamma" value="100" />
		<param name="sharpness" value="2000" />
		<param name="backlight_compensation" value="0" />

		<!-- 曝光/增益/白平衡 - 手动模式需按注释切对应开关后生效 -->
		<param name="gain" value="0" />
		<!-- <param name="exposure_time_absolute" value="50" />
		<param name="white_balance_temperature" value="4600" /> -->
	</node>

	<!-- 图像可视化节点 - 订阅相机图像话题，自适应窗口大小 -->
	<!-- <node name="camera_view" pkg="image_view" type="image_view" output="screen">
		<remap from="image" to="/usbgs1200p02_cam/image_raw" />
		<param name="autosize" value="true" />
	</node> -->


    <!-- ========== livox_ros_driver2 ========== -->
    <!--user configure parameters for ros start-->
	<arg name="lvx_file_path" default="livox_test.lvx"/>
	<arg name="bd_list" default="100000000000000"/>
	<arg name="xfer_format" default="1"/>
	<arg name="multi_topic" default="0"/>
	<arg name="data_src" default="0"/>
	<arg name="publish_freq" default="10.0"/>
	<arg name="output_type" default="0"/>
	<arg name="rviz_enable" default="false"/>
	<arg name="rosbag_enable" default="false"/>
	<arg name="cmdline_arg" default="$(arg bd_list)"/>
	<arg name="msg_frame_id" default="livox_frame"/>
	<arg name="lidar_bag" default="true"/>
	<arg name="imu_bag" default="true"/>
    <!--user configure parameters for ros end-->
    
    <param name="xfer_format" value="$(arg xfer_format)"/>
	<param name="multi_topic" value="$(arg multi_topic)"/>
	<param name="data_src" value="$(arg data_src)"/>
	<param name="publish_freq" type="double" value="$(arg publish_freq)"/>
	<param name="output_data_type" value="$(arg output_type)"/>
	<param name="cmdline_str" type="string" value="$(arg bd_list)"/>
	<param name="cmdline_file_path" type="string" value="$(arg lvx_file_path)"/>
	<param name="user_config_path" type="string" value="$(find livox_ros_driver2)/config/MID360_config.json"/>
	<param name="frame_id" type="string" value="$(arg msg_frame_id)"/>
	<param name="enable_lidar_bag" type="bool" value="$(arg lidar_bag)"/>
	<param name="enable_imu_bag" type="bool" value="$(arg imu_bag)"/>

    <node name="livox_lidar_publisher2" pkg="livox_ros_driver2" type="livox_ros_driver2_node" required="true" output="screen" args="$(arg cmdline_arg)"/>

    <group if="$(arg rviz_enable)">
        <!-- <node name="rviz_livox" pkg="rviz" type="rviz" respawn="true" args="-d $(find livox_ros_driver2)/config/display_point_cloud_ROS1.rviz"/> -->
        <!-- <node name="rviz" pkg="rviz" type="rviz" respawn="true" args="-d $(find hikrobot_camera)/rviz_config/hikrobot.rviz" /> -->
        <node name="rviz_MID360_HIK" pkg="rviz" type="rviz" respawn="true" args="-d $(find fast_calib)/rviz_cfg/MID360_HIKCS020.rviz"/>
    </group>

    <group if="$(arg rosbag_enable)">
        <node pkg="rosbag" type="record" name="record" output="screen" args="-a"/>
    </group>
</launch>
